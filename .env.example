# Налаштування й СЕКРЕТИ сайту. Скопіюйте цей файл у .env і впишіть свої значення:
#     cp .env.example .env
# Файл .env не потрапляє в git — паролі й токени лишаються тільки на сервері.
# Усе про сам сайт (назва, ціни, тексти) — у config/site.yaml, не тут.

# Секретний ключ для захисту входу в адмінку. Будь-який довгий випадковий рядок.
# Згенерувати:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Логін і пароль адмінки (пароль — від 8 символів). Застосовуються, поки в базі стоїть демо-пароль.
# Змінити пізніше:  python manage.py set-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Сповіщення власнику в Telegram про нові бронювання.
# Токен — від @BotFather; chat id — напишіть боту будь-що й відкрийте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates (поле chat → id).
# Перевірка: адмінка → «Надіслати тестове сповіщення».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 — додати в НОВУ базу демо-зайнятість і демо-заявки (для показу сайту клієнту). 0 — без них.
# Прибрати демо-дані перед запуском для гостей:  python manage.py seed --clear-demo
DEMO_DATA=1

# 1 — на сайті з HTTPS (PythonAnywhere, VPS із сертифікатом). Для запуску на своєму комп'ютері — 0.
SESSION_COOKIE_SECURE=0

# Часовий пояс сайту (сервери зазвичай працюють в UTC).
TIMEZONE=Europe/Kyiv

# ── Необов'язково: шляхи. Типово все лежить у папці проєкту, змінювати не потрібно. ──
# Який конфіг використовувати (шлях від папки проєкту або повний).
# SITE_CONFIG=config/site.yaml
# Файл бази даних (типово instance/<назва конфігу>.db).
# DATABASE_PATH=/var/lib/cottage/site.db
# Папка для бази й службових файлів (типово instance/ у проєкті).
# INSTANCE_PATH=/var/lib/cottage
# 1 — надсилати сповіщення одразу, без фонового потоку (на PythonAnywhere вмикається саме).
# NOTIFY_SYNC=1
# Порт для запуску `python app.py`.
# PORT=5000
