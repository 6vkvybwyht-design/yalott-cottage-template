# Налаштування сайту приватної садиби Forest House.
# Скопіюйте цей файл у .env і впишіть свої значення:  cp .env.example .env
# Файл .env не потрапляє в git — паролі й токени залишаються лише на сервері.

# Секретний ключ для захисту входу в адмінку. Будь-який довгий випадковий рядок.
# Згенерувати:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Логін і пароль адмінки (від 8 символів). Застосовуються, поки в базі стоїть демо-пароль.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 1 — додати демо-зайнятість листопада–грудня 2026 (для показу власнику). 0 — без неї.
# Стартові ціни (site_content.py) і святкові періоди (data/seed.json) завантажуються завжди.
# Діє лише під час створення нової бази.
DEMO_DATA=1

# 1 — на сайті з HTTPS (PythonAnywhere). Для запуску на своєму комп'ютері поставте 0.
SESSION_COOKIE_SECURE=0

# Сповіщення власнику в Telegram про нові бронювання.
# Токен від @BotFather і chat id власника.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Часовий пояс сайту (сервери PythonAnywhere працюють в UTC).
TIMEZONE=Europe/Kyiv
