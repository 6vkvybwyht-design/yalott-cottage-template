# Налаштування й СЕКРЕТИ сайту. Скопіюйте цей файл у .env і впишіть свої значення:
#     cp .env.example .env
# Файл .env не потрапляє в git — паролі й токени лишаються тільки на сервері.
# Усе про сам сайт (назва, ціни, тексти) — у config/site.yaml, не тут.

# ОБОВ'ЯЗКОВО. Секретний ключ для захисту входу в адмінку — довгий випадковий рядок (від 32 символів).
# Без нього сайт НЕ ЗАПУСКАЄТЬСЯ (жодного ключа «за замовчуванням» немає).
# На сервері `sudo new-site` генерує його сам. Вручну:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Логін і пароль адмінки (пароль — від 8 символів). Застосовуються під час створення бази
# (і замінюють демо-пароль, якщо він ще стоїть). Змінити пізніше:  python manage.py set-password
# Без пароля: демо-сайт (DEMO_DATA=1) — admin / demo2026; робочий — випадковий пароль у журналі сайту.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Сповіщення власнику в Telegram про нові бронювання.
# Токен — від @BotFather; chat id — напишіть боту будь-що й відкрийте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates (поле chat → id).
# Перевірка: адмінка → «Надіслати тестове сповіщення».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 — додати в НОВУ базу демо-зайнятість і демо-заявки (для показу сайту клієнту). 0 — без них.
# Прибрати демо-дані перед запуском для гостей:  python manage.py seed --clear-demo
DEMO_DATA=1

# Cookie входу лише через HTTPS. За замовчуванням (порожньо) — увімкнено.
# 0 — ЛИШЕ для запуску на своєму комп'ютері по http://localhost.
SESSION_COOKIE_SECURE=

# 1 (за замовчуванням) — сайт працює за вебсервером (Caddy на VPS, nginx на PythonAnywhere): справжня IP
# відвідувача береться з X-Forwarded-For. Потрібно для лімітів входу в адмінку й заявок.
# 0 — лише якщо gunicorn відкритий в інтернет напряму (так робити не варто).
BEHIND_PROXY=1

# Часовий пояс сайту (сервери зазвичай працюють в UTC).
TIMEZONE=Europe/Kyiv

# ── Необов'язково: шляхи. Типово все лежить у папці проєкту, змінювати не потрібно. ──
# Який конфіг використовувати (шлях від папки проєкту або повний).
# SITE_CONFIG=config/site.yaml
# Файл бази даних (типово instance/<назва конфігу>.db).
# DATABASE_PATH=/var/lib/cottage/site.db
# Папка для бази й службових файлів (типово instance/ у проєкті).
# INSTANCE_PATH=/var/lib/cottage
# 1 — надсилати сповіщення одразу, без фонового потоку (на PythonAnywhere вмикається саме).
# NOTIFY_SYNC=1
# Порт для запуску `python app.py`.
# PORT=5000

# Пароль демо-версії (необов'язково, лише коли в config/site.yaml demo.enabled: true).
# Клієнт вводить його після переходу за посиланням із python manage.py demo-link.
# Змінили пароль — усі, хто вже входив, мають ввести новий.
DEMO_PASSWORD=
